{
  "name": "idv-cryptic-map",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm --filter web build && pnpm --filter admin build",
    "preview": "pnpm --filter web preview",
    "test": "pnpm --filter @idv-map/shared test && pnpm --filter web test",
    "check:shared": "pnpm --filter @idv-map/shared typecheck",
    "check:worker": "tsc -p workers",
    "migrate:v2": "node scripts/migrate-v1-to-v2.mts",
    "import:nightmare": "node scripts/import-nightmare-maps.mts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260715.1",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "wrangler": "^4.110.0"
  }
}
