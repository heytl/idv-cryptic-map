{
  "cleanUrls": true,
  "buildCommand": null,
  "outputDirectory": "site",
  "redirects": [
    { "source": "/:version(v[0-9.]+)", "destination": "/:version/", "permanent": true },
    { "source": "/versions", "destination": "/versions/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
