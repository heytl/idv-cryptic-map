# Copy to .env.production.local for a release build.
# The origin must serve /maps-v4.json. Never use the admin API.
VITE_MAP_API_BASE_URL=https://your-production-domain.example
# Set a real WeChat AppID for device preview/upload.
WECHAT_APP_ID=
# Optional simulator-only bypass in .env.development.local. Ignored in release builds.
WECHAT_SKIP_DOMAIN_CHECK=false
